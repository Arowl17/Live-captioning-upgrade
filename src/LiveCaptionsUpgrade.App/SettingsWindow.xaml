<Window x:Class="LiveCaptionsUpgrade.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live Captions Upgrade – Settings"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,12,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Swatch" TargetType="Border">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="14" />
            <Setter Property="BorderBrush" Value="Gray" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </Window.Resources>

    <!-- Scrolls when the window is taller than the screen (small laptop screens). -->
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel>
        <GroupBox Header="Caption sharing (two computers)">
            <StackPanel>
                <RadioButton x:Name="SharingOffRadio" GroupName="Sharing" Margin="0,3" Checked="OnSharingModeChecked">
                    <TextBlock TextWrapping="Wrap" Text="Off" />
                </RadioButton>
                <RadioButton x:Name="SharingSendRadio" GroupName="Sharing" Margin="0,3" Checked="OnSharingModeChecked">
                    <TextBlock TextWrapping="Wrap" Text="Send captions to another computer (this one runs Live Captions)" />
                </RadioButton>
                <RadioButton x:Name="SharingReceiveRadio" GroupName="Sharing" Margin="0,3" Checked="OnSharingModeChecked">
                    <TextBlock TextWrapping="Wrap" Text="Show captions from another computer (for one without Live Captions, such as Windows 10)" />
                </RadioButton>
                <TextBlock x:Name="SharingStatusText" TextWrapping="Wrap" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="PairButton" Content="Pair with a computer…" Padding="10,2" Click="OnPair" />
                    <Button x:Name="ForgetButton" Content="Forget paired computer" Padding="10,2" Margin="6,0,0,0" Click="OnForget" />
                </StackPanel>
                <Border x:Name="FirewallBanner" Visibility="Collapsed" Background="#FFF4CE" BorderBrush="#E0C060"
                        BorderThickness="1" Padding="8,6" Margin="0,8,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Allow…" Padding="10,2" Margin="8,0,0,0" Click="OnAllowFirewall" />
                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="Windows Firewall may stop the other computer from connecting to this one." />
                    </DockPanel>
                </Border>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Caption appearance">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Font" />
                <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="FontBox" Margin="0,3" />

                <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Text size" />
                <Slider Grid.Row="1" Grid.Column="1" x:Name="FontSizeSlider" Minimum="8" Maximum="96"
                        IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                           Text="{Binding Value, ElementName=FontSizeSlider, StringFormat={}{0:0}}" />

                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Live text colour" />
                <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource SwatchButton}" Click="OnPickTextColor">
                    <Border x:Name="TextColorSwatch" Style="{StaticResource Swatch}" />
                </Button>

                <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Earlier text colour" />
                <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource SwatchButton}" Click="OnPickHistoryColor">
                    <Border x:Name="HistoryColorSwatch" Style="{StaticResource Swatch}" />
                </Button>

                <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Background colour" />
                <Button Grid.Row="4" Grid.Column="1" Style="{StaticResource SwatchButton}" Click="OnPickBackgroundColor">
                    <Border x:Name="BackgroundColorSwatch" Style="{StaticResource Swatch}" />
                </Button>

                <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="Background opacity" />
                <Slider Grid.Row="5" Grid.Column="1" x:Name="OpacitySlider" Minimum="0" Maximum="100"
                        IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" />
                <TextBlock Grid.Row="5" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                           Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:0}%}" />
            </Grid>
        </GroupBox>

        <GroupBox Header="Caption window">
            <StackPanel>
                <CheckBox x:Name="AlwaysOnTopBox" Content="Keep captions on top of other windows" />
                <CheckBox x:Name="ClickThroughBox" Content="Lock in place (clicks go to the window underneath)" />
                <TextBlock Style="{StaticResource Hint}" Margin="20,0,0,4"
                           Text="While locked, the mouse wheel can't scroll back. Unlock it from the tray icon." />

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Show/hide shortcut" />
                    <TextBox Grid.Column="1" x:Name="HotkeyBox" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                             VerticalContentAlignment="Center" Padding="4,2"
                             PreviewKeyDown="OnHotkeyPreviewKeyDown" />
                    <Button Grid.Column="2" Content="Clear" Padding="10,2" Margin="6,0,0,0" Click="OnClearHotkey" />
                </Grid>
                <TextBlock x:Name="HotkeyHint" Style="{StaticResource Hint}" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Scroll back">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Keep earlier text for" />
                    <Slider Grid.Column="1" x:Name="ScrollbackSlider" Minimum="1" Maximum="60"
                            IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"
                               Text="{Binding Value, ElementName=ScrollbackSlider, StringFormat={}{0:0} min}" />
                </Grid>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Scroll up with the mouse wheel over the captions. Older text is deleted from memory." />
            </StackPanel>
        </GroupBox>

        <GroupBox x:Name="LiveCaptionsGroup" Header="Windows Live Captions">
            <StackPanel>
                <CheckBox x:Name="HideLiveCaptionsBox" Content="Hide the original Live Captions window" />
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="How to hide it" />
                    <ComboBox Grid.Column="1" x:Name="HideMethodBox" Margin="0,3">
                        <ComboBoxItem Content="Invisible (recommended)" />
                        <ComboBoxItem Content="Minimize (try this if captions stop updating)" />
                    </ComboBox>
                </Grid>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Transcripts">
            <StackPanel>
                <CheckBox x:Name="SaveTranscriptBox" Content="Save what is said to a text file" />
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Folder" />
                    <TextBox Grid.Column="1" x:Name="TranscriptFolderBox" VerticalContentAlignment="Center" Padding="4,2" />
                    <Button Grid.Column="2" Content="Browse…" Padding="8,2" Margin="6,0,0,0" Click="OnBrowseTranscriptFolder" />
                    <Button Grid.Column="3" Content="Open" Padding="8,2" Margin="6,0,0,0" Click="OnOpenTranscriptFolder" />
                </Grid>
            </StackPanel>
        </GroupBox>

        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="OK" Width="80" IsDefault="True" Click="OnOk" />
            <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True" Click="OnCancel" />
            <Button Content="Apply" Width="80" Margin="8,0,0,0" Click="OnApply" />
        </StackPanel>
    </Grid>
</Window>
