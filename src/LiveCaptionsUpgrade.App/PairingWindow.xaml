<Window x:Class="LiveCaptionsUpgrade.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pair with another computer – Live Captions Upgrade"
        Width="470"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="MinWidth" Value="80" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="18">
        <!-- Step 1 (this computer asks): pick the other computer. -->
        <StackPanel x:Name="ChoosePanel">
            <TextBlock Style="{StaticResource Title}" Text="Pair with another computer" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,12"
                       Text="Open Live Captions Upgrade on the other computer and turn on caption sharing there too: Send on the computer with Live Captions, Show on the other one. It then appears below." />

            <TextBlock FontWeight="SemiBold" Text="Computers found on your network" />
            <ItemsControl x:Name="NearbyList" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding Detail}" Foreground="Gray" FontSize="11" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Pair" Tag="{Binding}" Click="OnPairNearby" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="NoNearbyText" Style="{StaticResource Hint}" Margin="0,4,0,0" Text="Looking…" />

            <TextBlock FontWeight="SemiBold" Text="Or enter its IP address" Margin="0,14,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="AddressBox" VerticalContentAlignment="Center" Padding="4,2" KeyDown="OnAddressKeyDown" />
                <Button Grid.Column="1" Content="Pair" Margin="6,0,0,0" Click="OnPairByAddress" />
            </Grid>
            <TextBlock x:Name="OwnAddressText" Style="{StaticResource Hint}" Margin="0,6,0,0" />

            <Button Content="Close" HorizontalAlignment="Right" Margin="0,16,0,0" IsCancel="True" Click="OnClose" />
        </StackPanel>

        <!-- Step 2 (both computers): compare the codes. -->
        <StackPanel x:Name="CodePanel" Visibility="Collapsed">
            <TextBlock x:Name="CodeTitle" Style="{StaticResource Title}" />
            <TextBlock x:Name="CodeHint" TextWrapping="Wrap" Margin="0,6,0,0" />
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Padding="0,14" Margin="0,14">
                <TextBlock x:Name="CodeText" FontSize="40" FontWeight="SemiBold" HorizontalAlignment="Center" FontFamily="Consolas" />
            </Border>
            <TextBlock x:Name="WaitingText" Style="{StaticResource Hint}" Visibility="Collapsed" Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ConfirmButton" Content="The codes match" Click="OnConfirm" />
                <Button Content="Cancel" Margin="8,0,0,0" Click="OnCancelPairing" />
            </StackPanel>
        </StackPanel>

        <!-- Step 3: how it went. -->
        <StackPanel x:Name="ResultPanel" Visibility="Collapsed">
            <TextBlock x:Name="ResultTitle" Style="{StaticResource Title}" />
            <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="0,6,0,14" />
            <Button x:Name="ResultClose" Content="Close" HorizontalAlignment="Right" Click="OnClose" />
        </StackPanel>
    </StackPanel>
</Window>
